# User overrides for simple-linux — sourced AFTER settings.default.env, so any
# variable set here takes precedence over the managed defaults in
# settings.default.env.
#
# This file is installed once and never overwritten by updates.
# Set ADDITIONAL_PACKAGES below, or override any settings.default.env variable.

# Extra packages to install on 'sudo sl-system sync' (space separated)
ADDITIONAL_PACKAGES=""

# Examples of overriding managed defaults:
#PACKAGES="${PACKAGES} superimportantpackage"
#GAMING_PACKAGES="${GAMING_PACKAGES} package"
#ADMIN_USER="myuser"
